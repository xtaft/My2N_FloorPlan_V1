# Dependencies — reinstalled with `npm install`, never committed (200+ MB)
node_modules/

# Build output — regenerated by `npm run build`, published by CI
dist/

# Vite's local dep-resolution cache
.vite/

# Claude Code's per-machine permission grants — full of absolute
# C:\Users\... paths that mean nothing on anyone else's machine.
# .claude/launch.json IS committed: it's the shared dev-server config.
.claude/settings.local.json

# Local env / editor / OS noise
.env
.env.local
.DS_Store
Thumbs.db
*.log
npm-debug.log*
